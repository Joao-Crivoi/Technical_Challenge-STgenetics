@using GoodHamburger.Web.Models.Enums
@inject IJSRuntime JS

<div class="splash-container">       
    <img src="images/logo.svg" class="splash-logo"/>     
    <div class="content_splash">
        <div class="hamburger-wrapper">
            <svg class="freeburger-arc" viewBox="0 0 400 250">
                <defs>
                    <path id="arc" d="M 50,180 A 150,150 0 0,1 350,180"/>
                </defs>
                <text class="neon-text @(_neonOn ? "aceso" : "")">
                    <textPath href="#arc" startOffset="50%" text-anchor="middle">
                        FREEBURGER
                    </textPath>
                </text>
            </svg>
            <img @onclick="HandleClick"
                src="images/cheeseburger.webp"
                class="hamburger-img bite-@clickCount @(_isVisible ? "img-visible" : "")"/>
        </div>
        <div class="cheese-text @(_textVisible ? "text-visible" : "")">
            <span class="cheese-text-1 nosifer-regular">CLICK ME</span>
            <span class="cheese-text-2 nosifer-regular">EAT ME</span>  
            <span class="cheese-text-3 nosifer-regular">WHATEVER</span>      
        </div>
    </div>
</div>

@code {
    [Parameter]
    public EventCallback OnCompleted { get; set; }
    private int clickCount = 0;
    private bool _isVisible = false;
    private bool _textVisible = false;

    private bool _neonOn = false;
    private string VisibilityClass => _isVisible ? "visible" : string.Empty;

    private string TextVisibilityClass => _textVisible ? "visible" : string.Empty;

    private async Task HandleClick()
    { 
        clickCount++;
        await JS.InvokeVoidAsync("playSound", "audio/bite.ogg");
        if (clickCount >= 3)
        {
            await OnCompleted.InvokeAsync();
            return;
        }
        await Task.Delay(3000);
    } 

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            #region Content Visibility

            await JS.InvokeVoidAsync("playSound", "audio/light_flickering.ogg");
            await Task.Delay(3000);
            await JS.InvokeVoidAsync("playSound", "audio/light_switch.ogg");
            _isVisible = true;
            _neonOn = true;
            StateHasChanged();

            #endregion

            #region Text Visibility

            await Task.Delay(1500);
            _textVisible = true;
            StateHasChanged();

             #endregion
        }
    }

}